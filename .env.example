# ============================================================
# Supabase — auth + database
# The browser NEVER talks to Supabase directly; every query goes through this
# app's own /api/* routes. That is why the anon key has no NEXT_PUBLIC_ prefix:
# it is a server-side value here, on purpose.
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# LiveKit — media server (self-hosted or LiveKit Cloud)
# Generate a key pair with:  docker run --rm livekit/generate
# ============================================================
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.example.com

# ============================================================
# Domains
# APP_DOMAIN is used to build invite links. Leave it empty and the app falls
# back to the forwarded host / Host header, which is correct behind a reverse
# proxy — but setting it explicitly is recommended in production.
# ============================================================
APP_DOMAIN=meet.example.com
LIVEKIT_DOMAIN=livekit.example.com
TURN_DOMAIN=livekit.example.com

# ============================================================
# Capacity guard
# Total concurrent participants across ALL rooms. When exceeded, creating rooms
# and joining are refused with 503. Sized to your media server's upstream
# bandwidth — 20 is a sane default for a ~40 Mbps uplink. Non-positive values
# fall back to 20.
# ============================================================
MAX_CONCURRENT_PARTICIPANTS=20

# ============================================================
# Media provider selection (the MediaProvider abstraction lets you swap the
# media backend without touching any UI code). Only 'livekit' is implemented.
# ============================================================
MEDIA_PROVIDER_DEFAULT=livekit

# Placeholder for an alternative provider implementation (not implemented).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
